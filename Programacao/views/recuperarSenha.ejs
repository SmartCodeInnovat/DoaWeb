<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Senha</title>
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/stylesheets/autenticacao.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
  <% if (message !== "") {%>
    <section class="message message-<%= type %>">
      <p><%= message %></p>
      <span id="close-message"><i class="bi bi-x"></i></span>
    </section>
    <% }%>

    <section class="containersenha">
      <div class="sidebar">
        <img src="/images/logo3.png" alt="Logo da doaweb">
        <div class="centered-text">
          <h1>Seja bem vindo!</h1>
          <p>Acesse sua conta</p>
        </div>
      </div>
      <div class="contentsenha">
        <div class="centered-text">
          <h1>Redefinir sua senha</h1>
        </div>
        <form id="forgot-password-form" action= "/recuperarSenha" method="POST">
          <div class="form-group green-bg rounded">
            <input type="email" id="email" name="email" placeholder="E-mail" required>
          </div>
          <div class="form-group">
            <button type="submit" class="send-code-button">Enviar Código</button>
          </div>
          </form>
          <form id="forgot-password-form">
          <div class="form-group green-bg rounded">
            <input type="codigo" id="codigo" name="codigo" placeholder="Código" required>
          </div>
          <div class="form-group green-bg rounded">
            <input type="novasenha" id="novasenha" name="novasenha" placeholder="Nova senha" required>
          </div>
          <div class="centered-text">
            <button type="submit" class="green-button"onclick="window.location.href = '/evento';">ENTRAR</button>
          </div>
        </form>
      </div>
    </section>
    <script src="/javascripts/script.js"></script>
    <script src="https://accounts.google.com/gsi/client" async></script>
    <script src="https://unpkg.com/jwt-decode/build/jwt-decode.js" async></script>
</body>

</html>
